    <string>/Users/jnavarro/agente</string>
    <key>StandardOutPath</key>
    <string>/Users/jnavarro/agente/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jnavarro/agente/logs/launchd.err.log</string>
