      "googleflights",
      "googleflights:directos",
      "booking",
      "booking_intl",
      "kiwi",
      "googleflights_split",
      "googleflights_split:directos",
      "kiwi_intl",
      "travelpayouts"
    ],
    "googleflights": {
      "airlines": [
        "IB",
        "AM",
        "UX",
        "2W"
      ]
    },
    "kiwi": {
      "limit": 20,
      "max_stops": 0
    },
    "kiwi_intl": {
      "min_saving_pct": 3
    },
    "booking": {
      "min_interval_minutes": 60,
      "cooldown_after_fail_minutes": 120
